rules_version = '2';

// Правила безопасности JoyRest Games. Модель данных — раздел 5 CLAUDE.md.
// Тесты: tests/rules/firestore.test.ts (npm run test:rules).
// Те же права продублированы обычными функциями в src/data/permissions.ts (для интерфейса
// и будущего своего сервера) — меняйте оба места вместе.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Общие проверки ----------

    function signedIn() {
      return request.auth != null;
    }

    // Владелец агентства. Тот же UID в src/data/config.ts.
    function isOwnerUid() {
      return signedIn() && request.auth.uid == 'bmBFBi7VmqVl7oIVyntw0QYRTYJ2';
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isOwnerUid()
        || (hasProfile() && profile().role == 'admin' && profile().active == true);
    }

    // Ведущий — активный host или admin.
    function isHost() {
      return isAdmin()
        || (hasProfile() && profile().role == 'host' && profile().active == true);
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 30;
    }

    // ---------- Ведущие ----------

    match /users/{uid} {
      // Свой профиль читает и отключённый ведущий: так он видит, что аккаунт отключён.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Аккаунты ведёт только admin. Ведущий не может сам поменять себе роль.
      // Владельца агентства нельзя отключить или понизить.
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['role', 'name', 'active', 'email', 'createdAt'])
        && request.resource.data.role in ['admin', 'host']
        && validName(request.resource.data.name)
        && request.resource.data.active is bool
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && (uid != 'bmBFBi7VmqVl7oIVyntw0QYRTYJ2'
          || (request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if isAdmin() && uid != 'bmBFBi7VmqVl7oIVyntw0QYRTYJ2';
    }

    // ---------- Игры ----------

    match /games/{gameId} {
      function canReadGame(data) {
        return data.scope == 'agency' || data.ownerId == request.auth.uid || isAdmin();
      }
      function canWriteGame(data) {
        return (data.scope == 'agency' && isAdmin())
          || (data.scope == 'personal' && isHost() && data.ownerId == request.auth.uid);
      }
      function validGame(data) {
        return data.keys().hasOnly(['scope', 'ownerId', 'title', 'mechanic', 'themeId', 'ageRating',
            'content', 'createdAt', 'updatedAt'])
          && data.scope in ['agency', 'personal']
          && data.title is string && data.title.size() > 0 && data.title.size() <= 80
          && data.mechanic is string
          && data.themeId is string
          && data.ageRating in ['0+', '12+', '18+']
          && data.updatedAt == request.time;
      }

      allow read: if isHost() && canReadGame(resource.data);
      allow create: if canWriteGame(request.resource.data)
        && validGame(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      // Библиотека и владелец игры не меняются: копия — это новая игра.
      allow update: if canWriteGame(resource.data)
        && validGame(request.resource.data)
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if canWriteGame(resource.data);
    }

    // ---------- Сессии ----------

    match /sessions/{sessionId} {
      function isSessionHost() {
        return signedIn() && resource.data.hostId == request.auth.uid;
      }

      // Документ сессии по id читают все вошедшие: гости, экран зала, пульт. Гость, который
      // уже в игре, знает id и видит сессию до конца, в том числе после завершения.
      allow get: if signedIn();
      // Поиск по коду — только незавершённые сессии (лобби и идущая игра) и не больше
      // 5 документов: после «Завершить игру» по коду сессию не найти. Ведущий видит все
      // свои сессии, admin — все (автоочистка старых сессий).
      allow list: if signedIn()
        && ((request.query.limit <= 5 && resource.data.state.phase in ['lobby', 'playing'])
          || resource.data.hostId == request.auth.uid
          || isAdmin());

      allow create: if isHost()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[0-9]{6}$')
        && request.resource.data.playMode in ['solo', 'teams']
        && request.resource.data.screenMode in ['laptop', 'remote', 'none']
        && request.resource.data.state.phase == 'lobby'
        && request.resource.data.createdAt == request.time;

      // Менять state, leaderboard и остальное может только владелец сессии.
      // Код, владелец и снимок игры после создания не меняются.
      allow update: if isSessionHost()
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.code == resource.data.code
        && request.resource.data.gameSnapshot == resource.data.gameSnapshot
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.state.phase in ['lobby', 'playing', 'finished'];

      // Старые сессии удаляет admin при входе в /admin (Cloud Functions на Spark нет).
      allow delete: if isSessionHost() || isAdmin();

      function session() {
        return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      }

      function hostsThisSession() {
        return signedIn() && session().hostId == request.auth.uid;
      }

      // ----- Участники: игрок, команда или телефон команды -----

      match /participants/{pid} {
        allow read: if signedIn();

        // Гость: документ игрока с id = uid. Команда: создатель становится капитаном.
        allow create: if signedIn()
          && session().state.phase != 'finished'
          && request.resource.data.keys().hasOnly(['name', 'kind', 'teamId', 'captainUid', 'joinedAt'])
          && validName(request.resource.data.name)
          && request.resource.data.captainUid == request.auth.uid
          && request.resource.data.joinedAt == request.time
          && (
            (request.resource.data.kind == 'player'
              && pid == request.auth.uid
              && (request.resource.data.teamId == null
                || get(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.resource.data.teamId)).data.kind == 'team'))
            || (request.resource.data.kind == 'team'
              && session().playMode == 'teams'
              && request.resource.data.teamId == null)
          );

        // Гость может сменить имя и команду у своего телефона. Ведущий — что угодно.
        allow update: if hostsThisSession()
          || (signedIn()
            && pid == request.auth.uid
            && resource.data.kind == 'player'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'teamId'])
            && validName(request.resource.data.name)
            && (request.resource.data.teamId == null
              || get(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.resource.data.teamId)).data.kind == 'team'));

        allow delete: if hostsThisSession() || isAdmin();
      }

      // ----- Ответы: один документ step_pid, без перезаписи -----

      match /answers/{answerId} {
        // Ответы видит только пульт ведущего (и admin при автоочистке).
        allow read: if hostsThisSession() || isAdmin();

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['step', 'pid', 'uid', 'value', 'submittedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.step is int
          && request.resource.data.pid is string
          && answerId == string(request.resource.data.step) + '_' + request.resource.data.pid
          // Время ответа ставит сервер.
          && request.resource.data.submittedAt == request.time
          // Отвечать можно только на текущий открытый шаг.
          && session().state.phase == 'playing'
          && session().state.step == request.resource.data.step
          && session().state.revealed == false
          // Отвечает сам игрок или капитан своей команды.
          && get(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.resource.data.pid)).data.captainUid == request.auth.uid;

        // Повторное нажатие не меняет первый ответ.
        allow update: if false;
        allow delete: if hostsThisSession() || isAdmin();
      }
    }

    // ---------- Итоги прошедших игр (История игр) ----------

    match /results/{sessionId} {
      function validResult(data) {
        return data.keys().hasOnly(['hostId', 'code', 'gameTitle', 'mechanic', 'themeId', 'playMode',
            'playedAt', 'participantsCount', 'board', 'savedAt'])
          && data.gameTitle is string && data.gameTitle.size() <= 80
          && data.playMode in ['solo', 'teams']
          && data.participantsCount is int && data.participantsCount >= 0
          && data.board is list && data.board.size() <= 500
          && data.savedAt == request.time;
      }
      function sessionData() {
        return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      }

      // Ссылку на итоги открывают без входа: в них только названия и очки.
      allow get: if true;
      allow list: if signedIn() && (resource.data.hostId == request.auth.uid || isAdmin());

      // Итоги пишет владелец сессии при завершении игры или admin при автоочистке.
      // Владелец итогов — всегда ведущий сессии.
      allow create, update: if signedIn()
        && validResult(request.resource.data)
        && request.resource.data.hostId == sessionData().hostId
        && (sessionData().hostId == request.auth.uid || isAdmin());

      allow delete: if signedIn() && (resource.data.hostId == request.auth.uid || isAdmin());
    }
  }
}
