# Caddy: сертификаты HTTPS выпускаются сами (Let's Encrypt, запасной — ZeroSSL).
{
	email {$ACME_EMAIL}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}

# Адрес посетителя для приложения (лимиты по IP) — только тот, что видит Caddy: присланный
# клиентом X-Forwarded-For перезаписывается, а не дописывается. Приложение верит этому
# заголовку только от адресов внутренней сети Docker (server/src/app.ts, trustProxy).
games.joy-rest.ru {
	import security
	encode zstd gzip
	reverse_proxy app-prod:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

# Тестовое окружение: проверки веток до выкладки на основной адрес. Поисковикам не показываем.
test.games.joy-rest.ru {
	import security
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	reverse_proxy app-test:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

# Сайт агентства: файлы из того же образа, что и платформа (app-prod выбирает сайт по Host),
# поэтому выкладка, откат и уведомления общие. Кэш и закрытие от поисковиков (robots.txt,
# X-Robots-Tag; `sudo joyrest site-indexing on|off`) задаёт приложение. Заявки — POST /api/lead.
# Заглушка «скоро» (soon/) больше не используется; остаётся в релизе для отката на прошлые версии.
joy-rest.ru {
	import security
	encode zstd gzip
	reverse_proxy app-prod:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

# Тестовый сайт агентства — версия из ветки (app-test). Поисковикам не показываем никогда.
test.joy-rest.ru {
	import security
	header {
		X-Robots-Tag "noindex, nofollow"
		defer
	}
	encode zstd gzip
	reverse_proxy app-test:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

www.joy-rest.ru {
	redir https://joy-rest.ru{uri} permanent
}
