#!/usr/bin/env bash
# joyrest — управление сервером JoyRest Games с телефона (Termius).
# Подробно — RUNBOOK.md. Команды, меняющие сервер, — через sudo.
#
# Выкладка (deploy) одна для всех путей: SSH из GitHub Actions (через привратник и очередь),
# сервер сам забирает тестовый релиз (auto-update по тегу test-release в GHCR), вручную из Termius.
# Шаги: блокировка → проверка активной игры → скачивание образа по коммиту → дамп базы →
# миграции → переключение → проверка /health → при ошибке откат на прошлую версию.
set -euo pipefail

# Docker и папки выкладки доступны только root: владелец (sudo без пароля) может писать
# просто `joyrest status`, команда сама перезапустится через sudo.
if [ "$(id -u)" != 0 ]; then
  if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    exec sudo -n "$0" "$@"
  fi
  case "${1:-}" in
    ""|help|-h|--help) ;;
    *) echo "❌ joyrest работает с правами администратора: sudo joyrest $*" >&2; exit 1 ;;
  esac
fi

ROOT_DIR="${JOYREST_ROOT:-/srv/joyrest}"
APP_REPO="${JOYREST_APP_REPO:-ghcr.io/joonde/joyrest-app}"
REGISTRY="${JOYREST_REGISTRY:-https://ghcr.io}"
DEPLOY_DIR="$ROOT_DIR/deploy"
QUEUE_DIR="$DEPLOY_DIR/queue"
SHA_RE='^[0-9a-f]{40}$'
KEEP_RELEASES=3
KEEP_DUMPS=5
# Игра считается идущей, если в сессии была активность за последние 30 минут: забытая
# незавершённая сессия выкладку не блокирует.
ACTIVE_MINUTES=30
# Идущая игра без нажатий пульта (перерыв) считается активной столько часов.
PLAYING_HOURS=3
HEALTH_TIMEOUT="${JOYREST_HEALTH_TIMEOUT:-120}"
# Настройки без секретов (SITE_ENABLED, SITE_INDEXING). Секреты — только secrets.env.
# Сайт и индексацию включает только владелец командами site / site-indexing: ни выкладка,
# ни установка, ни перезагрузка этот файл не создают и не меняют (server/src/siteSwitch.test.ts).
SETTINGS_FILE="$ROOT_DIR/settings.env"
# Вход на test.joy-rest.ru: «логин bcrypt-хэш», Caddy подключает файл (Caddyfile, basic_auth).
SITE_AUTH_DIR="$ROOT_DIR/caddy/etc/auth"
# Резервные копии: доступы restic и S3 — только backup.env (пишет `joyrest backup-setup`).
# Сроки хранения копий в S3 указываются в политике персональных данных (CLAUDE.md).
BACKUP_DIR="$ROOT_DIR/backups"
BACKUP_ENV="$ROOT_DIR/backup.env"
BACKUP_STATE="$BACKUP_DIR/state"
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=3
KEEP_LOCAL=3
# Имя хоста в копиях постоянное: после переустановки сервера сроки хранения продолжаются.
BACKUP_HOST=joyrest
# «Раз в неделю» и «раз в месяц» с запасом: таймер запускается со случайным сдвигом.
WEEK_SECONDS=$((6 * 86400 + 43200))
MONTH_SECONDS=$((27 * 86400 + 43200))

usage() {
  cat <<'TEXT'
Команды:
  joyrest status              версии, здоровье, последние выкладки, диск и память
  joyrest logs [сервис] [N]   последние N строк логов (по умолчанию все сервисы, 100 строк)
                              сервисы: app-prod, app-test, caddy, postgres
  joyrest restart [сервис]    перезапуск (без сервиса — всё)
  joyrest up                  запустить всё в текущих версиях
  joyrest deploy <коммит> [force]       выложить версию на основной адрес
  joyrest deploy-test <коммит>          выложить версию на test.games.joy-rest.ru
  joyrest rollback [test]     вернуть прошлую версию
  joyrest activate <тег>      выложить по тегу GHCR (main, release, sha-…)
  joyrest version             текущие версии

Сайт агентства joy-rest.ru (по умолчанию выключен — заглушка «скоро»):
  joyrest site [on|off] [force]
                              включить (on) или выключить (off) сайт на joy-rest.ru;
                              без аргумента — показать текущее состояние
  joyrest site-password       логин и пароль для test.joy-rest.ru (пароль вводится скрыто,
                              на сервере хранится только хэш)
  joyrest lead-bot [force]    бот для заявок с сайта: спросит токен (скрыто) и чат,
                              проверит, сохранит в secrets.env и перезапустит приложение
  joyrest site-indexing [on|off] [force]
                              открыть (on) или закрыть (off) сайт для поисковиков —
                              только при включённом сайте; без аргумента — текущее значение
  force — применить, даже если идёт игра (приложение перезапустится на несколько секунд)

Платформа на своём сервере:
  joyrest admin-password [test]
                              пароль владельца агентства для входа в студию (вводится скрыто,
                              хранится только хэш); test — для test.games.joy-rest.ru
  joyrest deploy-key test|prod
                              новый ключ выкладки: test — для веток (только test), prod — для
                              main (окружение GitHub production); показывается один раз
  joyrest db-roles [force]    приложения ходят в базу своими ролями: тестовая версия не видит
                              основную базу (один раз; приложения перезапустятся на ~10 с)
  joyrest data [server|firebase] [force]
                              где основная версия games.joy-rest.ru хранит данные: server —
                              свой сервер, firebase — откат на Firebase; без аргумента — текущее

Резервные копии (каждую ночь в 04:40, restic → Beget S3):
  joyrest backup-setup        подключить хранилище S3: ключи (скрыто), пароль копий, первая копия
  joyrest backup              сделать копию сейчас
  joyrest backups             список копий и итоги проверок
  joyrest restore <копия|latest> test
                              восстановить копию в тестовую базу (test.games.joy-rest.ru)
  joyrest restore <копия|latest> prod [force]
                              восстановить основную базу (спросит подтверждение; force — даже
                              если идёт игра); прежняя база остаётся joyrest_prod_before_restore
  joyrest restore-media <копия|latest> test|prod
                              картинки, музыку и аватарки из копии (только добавляет файлы)
  joyrest restore-settings    settings.env и пароль test.joy-rest.ru из последней копии
  joyrest notify-bot          служебный бот: сообщения о неудачных копиях и итог недели
TEXT
}

# ------------------------------------------------------------------ общее

die() { echo "❌ $*" >&2; exit 1; }

need_root() {
  [ "$(id -u)" = 0 ] || die "Нужны права администратора: sudo joyrest $*"
}

log() {
  local line
  line="$(date '+%F %T') $*"
  echo "$line"
  if [ -w "$DEPLOY_DIR" ]; then
    echo "$line" >> "$DEPLOY_DIR/deploy.log"
    # Журнал выкладок не растёт бесконечно.
    if [ "$(wc -l < "$DEPLOY_DIR/deploy.log")" -gt 3000 ]; then
      tail -n 2000 "$DEPLOY_DIR/deploy.log" > "$DEPLOY_DIR/deploy.log.tmp"
      mv -f "$DEPLOY_DIR/deploy.log.tmp" "$DEPLOY_DIR/deploy.log"
    fi
  fi
}

env_link() {
  case "$1" in
    prod) echo "$ROOT_DIR/current" ;;
    test) echo "$ROOT_DIR/test-current" ;;
    *) die "Неизвестное окружение: $1" ;;
  esac
}

service_of() { [ "$1" = prod ] && echo app-prod || echo app-test; }
host_of() { [ "$1" = prod ] && echo games.joy-rest.ru || echo test.games.joy-rest.ru; }

# Значение из release.env окружения; у тестового без своей версии — версия основного.
release_value() {
  local link file
  link=$(env_link "$1")
  [ -e "$link" ] || link="$ROOT_DIR/current"
  file="$link/release.env"
  [ -f "$file" ] || return 0
  sed -n "s/^$2=//p" "$file"
}

write_runtime() {
  local prod test
  prod=$(release_value prod APP_IMAGE)
  test=$(release_value test APP_IMAGE)
  [ -n "$prod" ] || die "Нет текущей версии ($ROOT_DIR/current)."
  printf 'APP_IMAGE=%s\nAPP_TEST_IMAGE=%s\n' "$prod" "${test:-$prod}" > "$ROOT_DIR/runtime.env.tmp"
  mv -f "$ROOT_DIR/runtime.env.tmp" "$ROOT_DIR/runtime.env"
}

dc() {
  local dir settings=()
  dir=$(readlink -f "$ROOT_DIR/current")
  [ -f "$ROOT_DIR/runtime.env" ] || write_runtime
  [ -f "$SETTINGS_FILE" ] && settings=(--env-file "$SETTINGS_FILE")
  docker compose --project-directory "$dir" -f "$dir/compose.yml" \
    --env-file "$ROOT_DIR/secrets.env" --env-file "$ROOT_DIR/runtime.env" "${settings[@]}" "$@"
}

health() {
  dc exec -T "$(service_of "$1")" node -e \
    "fetch('http://127.0.0.1:8080/health').then(r=>r.text()).then(t=>console.log(t),e=>{console.log('нет ответа: '+e.message);process.exit(1)})"
}

health_ok() {
  local body
  body=$(health "$1" 2>/dev/null || true)
  [[ "$body" == *'"ok":true'* && "$body" == *"\"version\":\"$2\""* ]]
}

wait_healthy() {
  local env=$1 version=$2 body deadline=$((SECONDS + HEALTH_TIMEOUT))
  while [ "$SECONDS" -lt "$deadline" ]; do
    body=$(health "$env" 2>/dev/null || true)
    if [[ "$body" == *'"ok":true'* && "$body" == *"\"version\":\"$version\""* ]]; then
      return 0
    fi
    sleep 3
  done
  log "Нет ответа /health с версией $version: ${body:-пусто}"
  return 1
}

set_status() {
  printf '%s %s\n' "$(date '+%F %T')" "$2" > "$DEPLOY_DIR/status-$1.tmp"
  chmod 644 "$DEPLOY_DIR/status-$1.tmp"
  mv -f "$DEPLOY_DIR/status-$1.tmp" "$DEPLOY_DIR/status-$1"
}

psql_prod() {
  dc exec -T postgres psql -v ON_ERROR_STOP=1 -U joyrest -d joyrest_prod -tAc "$1"
}

# psql_in <база> <запрос>; служебная база postgres — для создания, удаления и переименования баз.
psql_in() {
  dc exec -T postgres psql -v ON_ERROR_STOP=1 -U joyrest -d "$1" -tAc "$2"
}

# Число сессий с активностью за последние ACTIVE_MINUTES минут (таблица sessions с полями
# phase и updated_at появится в PR 3; пока её нет — 0). Если проверить не удалось — код 1:
# выкладка без force тогда считает, что игра идёт.
active_games() {
  local exists count
  exists=$(psql_prod "select to_regclass('public.sessions') is not null" 2>/dev/null) || return 1
  case "$exists" in
    f) echo 0; return 0 ;;
    t) ;;
    *) return 1 ;;
  esac
  # Активность — действие пульта за ACTIVE_MINUTES минут; у идущей игры — и долгий перерыв
  # (слайд «перерыв», тосты, танцы) до PLAYING_HOURS часов, и ответы или сигналы телефонов.
  count=$(psql_prod "select count(*) from sessions s
    where (s.phase in ('lobby', 'playing') and s.updated_at > now() - interval '$ACTIVE_MINUTES minutes')
       or (s.phase = 'playing' and s.updated_at > now() - interval '$PLAYING_HOURS hours')
       or (s.phase = 'playing' and exists (select 1 from participants p where p.session_id = s.id
             and greatest(p.joined_at, coalesce(p.seen_at, p.joined_at)) > now() - interval '$ACTIVE_MINUTES minutes'))" 2>/dev/null) \
    || return 1
  [[ "$count" =~ ^[0-9]+$ ]] || return 1
  echo "$count"
}

wait_postgres() {
  local deadline=$((SECONDS + 90))
  until dc exec -T postgres pg_isready -U joyrest -d joyrest_prod >/dev/null 2>&1; do
    if [ "$SECONDS" -ge "$deadline" ]; then
      log "PostgreSQL не запустилась за 90 секунд"
      return 1
    fi
    sleep 2
  done
}

ensure_test_db() {
  local count
  count=$(psql_prod "select count(*) from pg_database where datname = 'joyrest_test'") || return 1
  if [ "$count" = 0 ]; then
    psql_prod "create database joyrest_test owner joyrest" >/dev/null || return 1
    log "Создана база joyrest_test"
  fi
  db_role_grants
}

# ------------------------------------------------------------------ роли базы
# Приложения ходят в базу не суперпользователем joyrest, а своими ролями (`sudo joyrest db-roles`):
# joyrest_app_prod — только joyrest_prod, joyrest_app_test — только joyrest_test, обе без права
# менять схему. Тестовая версия (код любой ветки claude/*) так не прочитает основную базу.
# Миграции, дампы и восстановление по-прежнему делает joyrest.
DB_ROLE_PROD=joyrest_app_prod
DB_ROLE_TEST=joyrest_app_test

# psql_stdin <база> — запрос из stdin: пароли не попадают в аргументы процессов.
psql_stdin() {
  dc exec -T postgres psql -v ON_ERROR_STOP=1 -q -U joyrest -d "$1" >/dev/null
}

# Права ролей приложений; повторять можно сколько угодно. Ролей ещё нет — ничего не делает.
# Вызывается при каждой выкладке и после восстановления: новая база снова открыта для PUBLIC.
db_role_grants() {
  local db role exists
  exists=$(psql_in postgres "select count(*) from pg_roles where rolname in ('$DB_ROLE_PROD', '$DB_ROLE_TEST')" 2>/dev/null) || return 0
  [ "$exists" = 2 ] || return 0
  for db in joyrest_prod joyrest_test; do
    role=$([ "$db" = joyrest_prod ] && echo "$DB_ROLE_PROD" || echo "$DB_ROLE_TEST")
    [ "$(psql_in postgres "select count(*) from pg_database where datname = '$db'")" = 1 ] || continue
    psql_stdin postgres <<SQL || return 1
revoke connect, temporary on database $db from public;
grant connect on database $db to $role;
SQL
    psql_stdin "$db" <<SQL || return 1
revoke create on schema public from public;
grant usage on schema public to $role;
grant select, insert, update, delete on all tables in schema public to $role;
grant usage, select, update on all sequences in schema public to $role;
alter default privileges for role joyrest in schema public grant select, insert, update, delete on tables to $role;
alter default privileges for role joyrest in schema public grant usage, select, update on sequences to $role;
SQL
  done
}

# sudo joyrest db-roles [force] — завести роли приложений и переключить приложения на них.
# Повторный запуск оставляет пароли и заново выдаёт права. Приложения пересоздаются (~10 с).
cmd_db_roles() {
  need_root db-roles
  local force=${1:-} prod_pass test_pass out
  [ -z "$force" ] || [ "$force" = force ] || die "Аргумент — только force."
  [ -t 0 ] || die "Запустите в Termius: sudo joyrest db-roles"
  ensure_no_game "$force" "db-roles"
  wait_postgres || die "База не отвечает."
  ensure_test_db || die "Не удалось подготовить базу joyrest_test."

  prod_pass=$(env_value "$ROOT_DIR/secrets.env" PROD_DB_PASSWORD)
  test_pass=$(env_value "$ROOT_DIR/secrets.env" TEST_DB_PASSWORD)
  [ -n "$prod_pass" ] || prod_pass=$(openssl rand -hex 24)
  [ -n "$test_pass" ] || test_pass=$(openssl rand -hex 24)
  psql_stdin postgres <<SQL || die "Не удалось создать роли в базе."
do \$\$ begin
  if not exists (select from pg_roles where rolname = '$DB_ROLE_PROD') then create role $DB_ROLE_PROD login; end if;
  if not exists (select from pg_roles where rolname = '$DB_ROLE_TEST') then create role $DB_ROLE_TEST login; end if;
end \$\$;
alter role $DB_ROLE_PROD with login nosuperuser nocreatedb nocreaterole noreplication password '$prod_pass';
alter role $DB_ROLE_TEST with login nosuperuser nocreatedb nocreaterole noreplication password '$test_pass';
SQL
  db_role_grants || die "Не удалось выдать права ролям."

  # Проверка до переключения: тестовая роль не входит в основную базу, основная — читает свою.
  out=$(psql_in postgres "select has_database_privilege('$DB_ROLE_TEST', 'joyrest_prod', 'CONNECT')") || die "Не удалось проверить права."
  [ "$out" = f ] || die "Проверка не прошла: тестовая роль может войти в основную базу. Приложения не переключены."
  out=$(psql_prod "select has_table_privilege('$DB_ROLE_PROD', 'users', 'SELECT, INSERT, UPDATE, DELETE')") || die "Не удалось проверить права."
  [ "$out" = t ] || die "Проверка не прошла: основная роль не может работать с таблицами. Приложения не переключены."

  set_env_value "$ROOT_DIR/secrets.env" PROD_DB_USER "$DB_ROLE_PROD" || die "Не удалось записать secrets.env."
  set_env_value "$ROOT_DIR/secrets.env" PROD_DB_PASSWORD "$prod_pass" || die "Не удалось записать secrets.env."
  set_env_value "$ROOT_DIR/secrets.env" TEST_DB_USER "$DB_ROLE_TEST" || die "Не удалось записать secrets.env."
  set_env_value "$ROOT_DIR/secrets.env" TEST_DB_PASSWORD "$test_pass" || die "Не удалось записать secrets.env."
  prod_pass=""
  test_pass=""
  echo "Перезапускаю приложения на новых ролях (несколько секунд)…"
  recreate_apps app-prod app-test
  log "[db-roles] приложения ходят в базу своими ролями"
  echo "✅ Готово: основная версия — роль $DB_ROLE_PROD, тестовая — $DB_ROLE_TEST (только своя база)."
}

# Папки выкладки (на сервере после PR 1 их ещё нет).
ensure_dirs() {
  if getent group deploy >/dev/null 2>&1; then
    install -d -m 750 -o root -g deploy "$DEPLOY_DIR"
    install -d -m 770 -o root -g deploy "$QUEUE_DIR"
  else
    install -d -m 750 "$DEPLOY_DIR"
    install -d -m 770 "$QUEUE_DIR"
  fi
  install -d -m 700 "$BACKUP_DIR" "$BACKUP_DIR/predeploy" "$BACKUP_DIR/daily" "$BACKUP_STATE" "$BACKUP_DIR/cache"
  install -d -m 700 "$SITE_AUTH_DIR"
  # Картинки игр: файлы вне базы, пишет приложение (пользователь node в образе, uid 1000).
  install -d -m 755 "$ROOT_DIR/media"
  install -d -m 700 -o 1000 -g 1000 "$ROOT_DIR/media/prod" "$ROOT_DIR/media/test"
}

# Системные файлы из текущего релиза: команды, привратник, службы systemd, Caddy.
# Возвращает 0, если Caddyfile изменился (нужен caddy reload).
install_system() {
  local dir changed=1
  dir=$(readlink -f "$ROOT_DIR/current")
  install -m 755 "$dir/bin/joyrest" /usr/local/bin/joyrest
  install -m 755 "$dir/bin/joyrest-gate" /usr/local/bin/joyrest-gate

  ensure_dirs

  if [ -d "$dir/systemd" ] && command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    local unit reload=0
    for unit in "$dir"/systemd/*; do
      if ! cmp -s "$unit" "/etc/systemd/system/$(basename "$unit")"; then
        install -m 644 "$unit" /etc/systemd/system/
        reload=1
      fi
    done
    if [ "$reload" = 1 ]; then
      systemctl daemon-reload
      systemctl enable --now joyrest-deploy.path joyrest-update.timer joyrest-backup.timer >/dev/null 2>&1
    fi
  fi

  install -d -m 755 "$ROOT_DIR/caddy/etc"
  if ! cmp -s "$dir/caddy/Caddyfile" "$ROOT_DIR/caddy/etc/Caddyfile"; then
    install -m 644 "$dir/caddy/Caddyfile" "$ROOT_DIR/caddy/etc/Caddyfile.new"
    # Ошибка в новом Caddyfile не должна уронить сайт: проверяем им же работающим Caddy и при
    # ошибке оставляем прежний (Caddy не запущен — первая установка, проверять нечем).
    if dc exec -T caddy caddy version >/dev/null 2>&1 \
      && ! dc exec -T caddy caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile.new >/dev/null 2>&1; then
      rm -f "$ROOT_DIR/caddy/etc/Caddyfile.new"
      log "Caddy: новый Caddyfile с ошибкой — оставлен прежний"
      notify "⚠️ Новый Caddyfile из релиза с ошибкой — Caddy работает на прежнем. Нужна правка в репозитории."
    else
      mv -f "$ROOT_DIR/caddy/etc/Caddyfile.new" "$ROOT_DIR/caddy/etc/Caddyfile"
      changed=0
    fi
  fi
  rm -rf "$ROOT_DIR/caddy/etc/soon.new"
  cp -r "$dir/caddy/soon" "$ROOT_DIR/caddy/etc/soon.new"
  rm -rf "$ROOT_DIR/caddy/etc/soon"
  mv "$ROOT_DIR/caddy/etc/soon.new" "$ROOT_DIR/caddy/etc/soon"
  return "$changed"
}

reload_caddy() {
  if dc exec -T caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
    log "Caddy: новая конфигурация применена"
  else
    log "Caddy: reload не удался — перезапускаю"
    dc restart caddy
  fi
}

# Скачивает образ коммита и раскладывает его папку deploy/ в releases/<коммит>.
# Каждый шаг проверяется явно: при вызове из очереди и таймера (`deploy_env … || …`) bash
# отключает set -e внутри функций, поэтому на него здесь не полагаемся.
fetch_release() {
  local sha=$1 digest cid incoming="$ROOT_DIR/releases/.incoming-$1"
  docker pull -q "$APP_REPO:sha-$sha" >/dev/null || return 1
  digest=$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$APP_REPO:sha-$sha" \
    | grep -m1 "^$APP_REPO@sha256:" || true)
  [ -n "$digest" ] || digest="$APP_REPO:sha-$sha"
  if [ ! -f "$ROOT_DIR/releases/$sha/release.env" ]; then
    cid=$(docker create "$APP_REPO:sha-$sha") || return 1
    rm -rf "$incoming"
    if ! docker cp "$cid:/app/deploy" "$incoming" >/dev/null; then
      docker rm "$cid" >/dev/null 2>&1
      return 1
    fi
    docker rm "$cid" >/dev/null 2>&1 || true
    rm -rf "${ROOT_DIR:?}/releases/$sha"
    mv "$incoming" "$ROOT_DIR/releases/$sha" || return 1
  fi
  # Запускаем по неизменяемому отпечатку образа, а не по тегу.
  printf 'APP_VERSION=%s\nAPP_IMAGE=%s\n' "$sha" "$digest" > "$ROOT_DIR/releases/$sha/release.env" || return 1
}

# Пароль базы передаём файлом (--env-file), а не аргументом: аргументы видны в списке
# процессов и в docker inspect.
run_migrations() {
  local env=$1 image=$2 db password envfile code=0
  db=$([ "$env" = prod ] && echo joyrest_prod || echo joyrest_test)
  password=$(sed -n 's/^POSTGRES_PASSWORD=//p' "$ROOT_DIR/secrets.env")
  envfile=$(umask 077 && mktemp "$ROOT_DIR/.migrate-env.XXXXXX") || return 1
  printf 'DATABASE_URL=postgres://joyrest:%s@postgres:5432/%s\n' "$password" "$db" > "$envfile"
  docker run --rm --network joyrest_db --env-file "$envfile" "$image" node server/migrate-main.js || code=$?
  rm -f "$envfile"
  return "$code"
}

# Дамп основной базы в файл. Файл проверяется: не пустой и читается pg_restore.
dump_prod() {
  local file=$1
  if ! dc exec -T postgres pg_dump -U joyrest -Fc joyrest_prod > "$file" || [ ! -s "$file" ] \
    || ! dc exec -T postgres pg_restore --list < "$file" > /dev/null; then
    rm -f "$file"
    return 1
  fi
  chmod 600 "$file"
}

predeploy_dump() {
  local file
  file="$ROOT_DIR/backups/predeploy/$(date '+%Y%m%d-%H%M%S')-$(release_value prod APP_VERSION | cut -c1-12).dump"
  if ! dump_prod "$file"; then
    log "Дамп базы не получился"
    return 1
  fi
  log "Дамп базы перед выкладкой: $file ($(du -h "$file" | cut -f1))"
  find "$ROOT_DIR/backups/predeploy" -name '*.dump' -printf '%T@ %p\n' | sort -rn \
    | tail -n +$((KEEP_DUMPS + 1)) | cut -d' ' -f2- | xargs -r rm -f
}

switch_to() {
  local env=$1 sha=$2
  ln -sfn "releases/$sha" "$(env_link "$env").new" || return 1
  mv -Tf "$(env_link "$env").new" "$(env_link "$env")" || return 1
  write_runtime
}

start_env() {
  if [ "$1" = prod ]; then
    if install_system; then dc up -d --remove-orphans; reload_caddy; else dc up -d --remove-orphans; fi
  else
    dc up -d --no-deps app-test
  fi
}

# Старые релизы и образы: оставляем текущие и KEEP_RELEASES последних.
prune_releases() {
  local keep dir name
  keep=" $(basename "$(readlink -f "$ROOT_DIR/current")") "
  [ -e "$ROOT_DIR/test-current" ] && keep+="$(basename "$(readlink -f "$ROOT_DIR/test-current")") "
  keep+="$(tail -n "$KEEP_RELEASES" "$DEPLOY_DIR/history-prod" 2>/dev/null | tr '\n' ' ') "
  for dir in "$ROOT_DIR"/releases/*/; do
    name=$(basename "$dir")
    [[ "$name" =~ $SHA_RE ]] || continue
    [[ "$keep" == *" $name "* ]] && continue
    rm -rf "${ROOT_DIR:?}/releases/$name"
    docker image rm "$APP_REPO:sha-$name" >/dev/null 2>&1 || true
  done
  docker image prune -f >/dev/null 2>&1 || true
}

# ------------------------------------------------------------------ выкладка

# deploy_env <prod|test> <коммит> [force] — 0 успех, 1 ошибка (с откатом), 3 отложено (идёт игра).
deploy_env() {
  local env=$1 sha=$2 force=${3:-} prev result
  [[ "$sha" =~ $SHA_RE ]] || die "Коммит — 40 символов 0-9a-f."
  [ -z "$force" ] || [ "$force" = force ] || die "Третий аргумент — только force."

  ensure_dirs
  exec 9>"$DEPLOY_DIR/lock"
  flock -w 900 9 || die "Другая выкладка идёт дольше 15 минут."

  if [ "$(release_value "$env" APP_VERSION)" = "$sha" ] && [ -e "$(env_link "$env")" ] && health_ok "$env" "$sha"; then
    set_status "$env" "ok $sha (уже выложена)"
    log "[$env] $sha уже выложена"
    return 0
  fi

  # Основную версию во время игры не трогаем. Не удалось проверить — считаем, что игра идёт:
  # таймер повторит через 2 минуты, обойти можно только вручную (force).
  if [ "$env" = prod ] && [ "$force" != force ]; then
    local active
    if ! active=$(active_games); then
      set_status "$env" "blocked $sha: не удалось проверить, идёт ли игра (повтор через 2 мин; вручную — force)"
      log "[$env] $sha отложена: не удалось проверить активные игры"
      return 3
    fi
    if [ "$active" -gt 0 ]; then
      set_status "$env" "blocked $sha: идёт игра ($active сесс. с активностью за $ACTIVE_MINUTES мин)"
      log "[$env] $sha отложена: идёт игра ($active)"
      return 3
    fi
  fi

  set_status "$env" "running $sha"
  log "[$env] выкладка $sha"
  # До переключения версии любая ошибка оставляет сайт на прошлой версии. Метку failed-<env>
  # здесь не ставим: таймер повторит попытку (сеть, GHCR и база могут ожить).
  if ! fetch_release "$sha"; then
    set_status "$env" "failed $sha: не скачался образ из GHCR, версия не переключалась"
    log "[$env] $sha: не скачался образ"
    return 1
  fi
  prev=$(basename "$(readlink -f "$(env_link "$env")" 2>/dev/null || true)")
  # У тестового окружения без своей версии откатываемся на версию основного.
  [[ "$prev" =~ $SHA_RE ]] || prev=$(release_value prod APP_VERSION)

  if ! wait_postgres || ! ensure_test_db; then
    set_status "$env" "failed $sha: база недоступна, версия не переключалась"
    log "[$env] $sha: база недоступна"
    return 1
  fi
  if [ "$env" = prod ] && ! predeploy_dump; then
    set_status "$env" "failed $sha: не получился дамп базы, версия не переключалась"
    log "[$env] $sha: не получился дамп базы"
    return 1
  fi

  if ! run_migrations "$env" "$(sed -n 's/^APP_IMAGE=//p' "$ROOT_DIR/releases/$sha/release.env")"; then
    set_status "$env" "failed $sha: ошибка миграции, версия не переключалась"
    echo "$sha" > "$DEPLOY_DIR/failed-$env"
    log "[$env] $sha: ошибка миграции"
    return 1
  fi

  # Ошибку переключения или запуска ловит проверка /health ниже и откатывает.
  switch_to "$env" "$sha" || log "[$env] $sha: ошибка переключения"
  start_env "$env" || log "[$env] $sha: ошибка запуска контейнеров"
  if wait_healthy "$env" "$sha"; then
    echo "$sha" >> "$DEPLOY_DIR/history-$env"
    tail -n 20 "$DEPLOY_DIR/history-$env" > "$DEPLOY_DIR/history-$env.tmp" && mv -f "$DEPLOY_DIR/history-$env.tmp" "$DEPLOY_DIR/history-$env"
    rm -f "$DEPLOY_DIR/failed-$env"
    set_status "$env" "ok $sha"
    log "[$env] $sha выложена"
    prune_releases
    return 0
  fi

  echo "$sha" > "$DEPLOY_DIR/failed-$env"
  if [[ "$prev" =~ $SHA_RE ]] && [ "$prev" != "$sha" ]; then
    log "[$env] $sha не прошла проверку — откат на $prev"
    switch_to "$env" "$prev" || log "[$env] ошибка переключения на $prev"
    start_env "$env" || log "[$env] ошибка запуска контейнеров $prev"
    if wait_healthy "$env" "$prev"; then result="откат на $prev"; else result="откат на $prev НЕ ПОДНЯЛСЯ"; fi
  else
    result="прошлой версии нет"
  fi
  set_status "$env" "failed $sha: не прошла /health, $result"
  log "[$env] $sha: ошибка, $result"
  return 1
}

# ------------------------------------------------------------------ настройки и секреты

# Значение, вставленное с телефона: без \r\n, пробелов, неразрывных и невидимых символов.
clean_value() {
  printf '%s' "$1" | LC_ALL=C sed -e 's/\xc2\xa0//g; s/\xe2\x80[\x8b-\x8d]//g; s/\xef\xbb\xbf//g' | tr -d '\r\n\t '
}

# set_env_value <файл> <ИМЯ> <значение> — заменяет строку ИМЯ=… целиком, остальные строки
# не трогает. Запись атомарная (временный файл → mv), права 600.
set_env_value() {
  local file=$1 key=$2 value=$3 tmp
  tmp=$(umask 077 && mktemp "$file.XXXXXX") || return 1
  if ! { if [ -f "$file" ]; then grep -v "^$key=" "$file" || true; fi; printf '%s=%s\n' "$key" "$value"; } > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  chmod 600 "$tmp" && mv -f "$tmp" "$file"
}

env_value() {
  [ -f "$1" ] || return 0
  sed -n "s/^$2=//p" "$1" | tail -n 1
}

# Перед перезапуском основной версии: во время игры без force не трогаем (как выкладку).
ensure_no_game() {
  local force=$1 command=$2 active
  [ "$force" = force ] && return 0
  if ! active=$(active_games); then
    die "Не удалось проверить, идёт ли игра. Повторите позже или: sudo joyrest $command force"
  fi
  if [ "$active" -gt 0 ]; then
    die "Идёт игра ($active сесс.). Повторите после игры или: sudo joyrest $command force"
  fi
}

# Приложения читают переменные при создании контейнера, поэтому restart не годится —
# пересоздаём (несколько секунд) и ждём /health с той же версией.
recreate_apps() {
  local service env
  dc up -d --no-deps "$@" || die "Не удалось перезапустить: $*"
  for service in "$@"; do
    env=$([ "$service" = app-prod ] && echo prod || echo test)
    wait_healthy "$env" "$(release_value "$env" APP_VERSION)" || die "$service не ответил после перезапуска: joyrest logs $service 100"
  done
}

# Вызов Bot API. Адрес с токеном передаётся curl через stdin (-K -), а не аргументом:
# аргументы видны в списке процессов. Тело ответа на экран не выводим — только описание ошибки.
telegram_call() {
  local token=$1 method=$2 body=$3 out
  if ! out=$(printf 'url = "https://api.telegram.org/bot%s/%s"\n' "$token" "$method" \
      | curl -sS --max-time 15 -K - -H 'Content-Type: application/json' -d "$body" 2>&1); then
    echo "Нет связи с api.telegram.org: ${out##*curl: }"
    return 1
  fi
  [[ "$out" == *'"ok":true'* ]] && return 0
  echo "Telegram ответил: $(printf '%s' "$out" | sed -n 's/.*"description":"\([^"]*\)".*/\1/p')"
  return 1
}

# ------------------------------------------------------------------ резервные копии
# Каждую ночь (joyrest-backup.timer → backup-nightly): дамп joyrest_prod на диск
# (backups/daily, KEEP_LOCAL последних) → restic в Beget S3 (зашифровано паролем restic,
# пароль владелец хранит у себя) → forget по срокам хранения. Раз в неделю prune, выборочная
# проверка целостности и итог в Telegram, раз в месяц — проверка восстановления во временную
# базу. prune и проверки во время игры откладываются на следующую ночь (то же правило 30 минут).

# Уведомление через служебного бота (sudo joyrest notify-bot). Нет бота — только журнал.
notify() {
  local token chat body reason
  token=$(env_value "$ROOT_DIR/secrets.env" NOTIFY_TELEGRAM_TOKEN)
  chat=$(env_value "$ROOT_DIR/secrets.env" NOTIFY_TELEGRAM_CHAT_ID)
  if [ -z "$token" ] || [ -z "$chat" ]; then
    log "Уведомление не отправлено (нет бота: sudo joyrest notify-bot): $1"
    return 0
  fi
  body=$(jq -nc --arg chat "$chat" --arg text "$1" '{chat_id: $chat, text: $text}') || return 0
  reason=$(telegram_call "$token" sendMessage "$body") || log "Уведомление не отправлено: $reason"
  return 0
}

backup_configured() {
  [ -n "$(env_value "$BACKUP_ENV" RESTIC_REPOSITORY)" ] && [ -n "$(env_value "$BACKUP_ENV" RESTIC_PASSWORD)" ]
}

# restic с доступами из backup.env (файл читается построчно, не исполняется). Пароль и ключи —
# в окружении процесса (видно только root), не в аргументах.
restic_run() {
  command -v restic >/dev/null 2>&1 || { echo "restic не установлен (sudo joyrest backup-setup)"; return 1; }
  (
    RESTIC_REPOSITORY=$(env_value "$BACKUP_ENV" RESTIC_REPOSITORY)
    RESTIC_PASSWORD=$(env_value "$BACKUP_ENV" RESTIC_PASSWORD)
    AWS_ACCESS_KEY_ID=$(env_value "$BACKUP_ENV" AWS_ACCESS_KEY_ID)
    AWS_SECRET_ACCESS_KEY=$(env_value "$BACKUP_ENV" AWS_SECRET_ACCESS_KEY)
    RESTIC_CACHE_DIR="$BACKUP_DIR/cache"
    export RESTIC_REPOSITORY RESTIC_PASSWORD AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY RESTIC_CACHE_DIR
    exec nice -n 10 restic --quiet "$@"
  )
}

# Причина ошибки коротко: строка «Fatal: …» restic, иначе последняя непустая строка.
short_reason() {
  local line
  line=$(printf '%s\n' "$1" | grep -m1 -E '^(Fatal|error|ERROR|pg_restore: error)' || true)
  [ -n "$line" ] || line=$(printf '%s\n' "$1" | sed '/^[[:space:]]*$/d' | tail -n 1)
  printf '%s' "${line#Fatal: }" | tr -d '\000-\037' | cut -c1-300
}

state_get() { cat "$BACKUP_STATE/$1" 2>/dev/null || true; }
state_set() {
  printf '%s\n' "$2" > "$BACKUP_STATE/$1.tmp" && mv -f "$BACKUP_STATE/$1.tmp" "$BACKUP_STATE/$1"
}
# due <имя> <секунд> — 0, если шаг ни разу не делали или делали давно.
due() {
  local last
  last=$(state_get "$1")
  [[ "$last" =~ ^[0-9]+$ ]] || return 0
  [ $(($(date +%s) - last)) -ge "$2" ]
}
day_time() { date -d "@$1" '+%d.%m %H:%M'; }

# Одна копия: дамп на диск → S3 (база и настройки) → forget по срокам.
# 0 — готово, 1 — ошибка (причина в BACKUP_REASON), 2 — только на диске (S3 не настроен).
BACKUP_REASON=""
backup_once() {
  local file out size paths=() path
  ensure_dirs
  if ! wait_postgres; then BACKUP_REASON="база не отвечает"; return 1; fi
  file="$BACKUP_DIR/daily/$(date '+%Y%m%d-%H%M%S').dump"
  if ! dump_prod "$file"; then BACKUP_REASON="не получился дамп базы (pg_dump)"; return 1; fi
  size=$(du -h "$file" | cut -f1)
  find "$BACKUP_DIR/daily" -name '*.dump' -printf '%T@ %p\n' | sort -rn \
    | tail -n +$((KEEP_LOCAL + 1)) | cut -d' ' -f2- | xargs -r rm -f
  log "[backup] дамп базы: $file ($size)"
  if ! backup_configured; then
    BACKUP_REASON="копия только на диске сервера: хранилище S3 не настроено (sudo joyrest backup-setup)"
    return 2
  fi

  # restic читает уже проверенный файл: оборванный pg_dump не станет «копией».
  if ! out=$(restic_run backup --host "$BACKUP_HOST" --tag db --stdin --stdin-filename joyrest_prod.dump < "$file" 2>&1); then
    BACKUP_REASON="хранилище S3 не приняло копию: $(short_reason "$out")"
    return 1
  fi
  for path in "$SETTINGS_FILE" "$SITE_AUTH_DIR"; do
    if [ -e "$path" ]; then paths+=("$path"); fi
  done
  if [ ${#paths[@]} -gt 0 ] && ! out=$(restic_run backup --host "$BACKUP_HOST" --tag config "${paths[@]}" 2>&1); then
    BACKUP_REASON="база сохранена, настройки — нет: $(short_reason "$out")"
    return 1
  fi
  # Картинки, музыка и аватарки (media/prod вместе с audio/ и profile/). Имена файлов — sha256,
  # файлы не меняются, поэтому restic каждую ночь отправляет только новые.
  if [ -d "$ROOT_DIR/media/prod" ] \
    && ! out=$(restic_run backup --host "$BACKUP_HOST" --tag media --exclude '*.tmp' "$ROOT_DIR/media/prod" 2>&1); then
    BACKUP_REASON="база сохранена, картинки и музыка — нет: $(short_reason "$out")"
    return 1
  fi
  state_set last-ok "$(date +%s) $size"
  log "[backup] копия в S3 сделана ($size)"
  # Сроки хранения. Место освобождает prune (раз в неделю).
  if ! out=$(restic_run forget --host "$BACKUP_HOST" --group-by host,tags \
      --keep-daily "$KEEP_DAILY" --keep-weekly "$KEEP_WEEKLY" --keep-monthly "$KEEP_MONTHLY" 2>&1); then
    log "[backup] forget не удался: $(short_reason "$out")"
    notify "⚠️ Резервная копия сделана, но старые копии не отмечены к удалению: $(short_reason "$out")"
  fi
  return 0
}

# restore_into <база> <файл дампа>: база создаётся заново и заполняется из дампа.
restore_into() {
  local db=$1 file=$2
  psql_in postgres "drop database if exists $db with (force)" >/dev/null 2>&1 || return 1
  psql_in postgres "create database $db owner joyrest" >/dev/null || return 1
  dc exec -T postgres pg_restore -U joyrest --no-owner --exit-on-error -d "$db" < "$file"
}

# Проверка восстановления: последняя копия из S3 → временная база → таблицы на месте → удалить.
RESTORE_CHECK=""
restore_check() {
  local file out expected tables rows code=0
  file=$(umask 077 && mktemp "$BACKUP_DIR/restorecheck.XXXXXX") || { RESTORE_CHECK="нет места для файла"; return 1; }
  if ! out=$(restic_run dump --host "$BACKUP_HOST" --tag db latest /joyrest_prod.dump 2>&1 > "$file"); then
    RESTORE_CHECK="копия не скачалась: $(short_reason "$out")"
    code=1
  elif ! out=$(restore_into joyrest_restorecheck "$file" 2>&1); then
    RESTORE_CHECK="копия не восстановилась: $(short_reason "$out")"
    code=1
  else
    expected=$(dc exec -T postgres pg_restore --list < "$file" | grep -c ' TABLE public ' || true)
    tables=$(psql_in joyrest_restorecheck "select count(*) from pg_tables where schemaname = 'public'" || echo "?")
    rows=$(psql_in joyrest_restorecheck "analyze; select coalesce(sum(n_live_tup), 0) from pg_stat_user_tables" | tail -n 1 || echo "?")
    if [ "$tables" = "$expected" ]; then
      RESTORE_CHECK="таблиц $tables, строк $rows"
    else
      RESTORE_CHECK="в копии таблиц $expected, восстановилось $tables"
      code=1
    fi
  fi
  psql_in postgres "drop database if exists joyrest_restorecheck with (force)" >/dev/null 2>&1 || true
  rm -f "$file"
  return "$code"
}

backup_count() {
  restic_run snapshots --host "$BACKUP_HOST" --tag db --json 2>/dev/null | jq 'length' 2>/dev/null || echo "?"
}

# Строка для joyrest status и итогов недели.
backup_summary() {
  local last ok_time size age
  last=$(state_get last-ok)
  if ! backup_configured; then
    echo "⚠️ хранилище S3 не настроено (sudo joyrest backup-setup), есть только копии на диске"
    return 0
  fi
  if [ -z "$last" ]; then
    echo "⚠️ в S3 ещё ни одной копии ($(state_get status))"
    return 0
  fi
  ok_time=${last%% *}
  size=${last#* }
  age=$(($(date +%s) - ok_time))
  if [ "$age" -gt $((36 * 3600)) ]; then
    echo "⚠️ последняя копия $(day_time "$ok_time") ($size) — больше 36 часов назад; $(state_get status)"
  else
    echo "последняя $(day_time "$ok_time") ($size) ✅"
  fi
}

# Ночной запуск (joyrest-backup.timer).
cmd_backup_nightly() {
  need_root backup-nightly
  local code=0 active out game=0 check summary
  ensure_dirs
  exec 8>"$BACKUP_DIR/lock"
  flock -n 8 || { log "[backup] другая копия ещё идёт — пропускаю"; return 0; }

  backup_once || code=$?
  case "$code" in
    0) state_set status "ok $(date '+%F %T')" ;;
    2) state_set status "local $(date '+%F %T')" ;;
    *)
      state_set status "failed $(date '+%F %T'): $BACKUP_REASON"
      log "[backup] копия не сделана: $BACKUP_REASON"
      notify "⚠️ Резервная копия не сделана: $BACKUP_REASON"
      ;;
  esac

  if [ "$code" = 0 ]; then
    if due last-prune "$WEEK_SECONDS" || due last-check "$WEEK_SECONDS" || due last-restore-check "$MONTH_SECONDS"; then
      if ! active=$(active_games); then
        game=1
        log "[backup] не удалось проверить, идёт ли игра — prune и проверки на следующую ночь"
      elif [ "$active" -gt 0 ]; then
        game=1
        log "[backup] идёт игра ($active) — prune и проверки на следующую ночь"
      fi
    fi
    if [ "$game" = 0 ] && due last-prune "$WEEK_SECONDS"; then
      if out=$(restic_run prune 2>&1); then
        state_set last-prune "$(date +%s)"
        log "[backup] prune: старые копии удалены"
      else
        log "[backup] prune не удался: $(short_reason "$out")"
        notify "⚠️ Не удалось удалить старые резервные копии: $(short_reason "$out")"
      fi
    fi
    if [ "$game" = 0 ] && due last-check "$WEEK_SECONDS"; then
      state_set last-check "$(date +%s)"
      if out=$(restic_run check --read-data-subset=10% 2>&1); then
        state_set check-result "✅ $(date '+%d.%m')"
        log "[backup] проверка целостности: ✅"
      else
        state_set check-result "❌ $(date '+%d.%m'): $(short_reason "$out")"
        log "[backup] проверка целостности не прошла: $(short_reason "$out")"
        notify "⚠️ Проверка целостности резервных копий не прошла: $(short_reason "$out")"
      fi
    fi
    if [ "$game" = 0 ] && due last-restore-check "$MONTH_SECONDS"; then
      state_set last-restore-check "$(date +%s)"
      if restore_check; then
        state_set restore-result "✅ $(date '+%d.%m'), $RESTORE_CHECK"
        log "[backup] проверка восстановления: ✅ $RESTORE_CHECK"
      else
        state_set restore-result "❌ $(date '+%d.%m'): $RESTORE_CHECK"
        log "[backup] проверка восстановления не прошла: $RESTORE_CHECK"
        notify "⚠️ Проверка восстановления резервной копии не прошла: $RESTORE_CHECK"
      fi
    fi
  fi

  # Итог раз в неделю, после проверки целостности: если её отложили из-за игры — итог тоже.
  # При ошибке копии сообщение уже ушло выше.
  if due last-summary "$WEEK_SECONDS" && ! { [ "$game" = 1 ] && due last-check "$WEEK_SECONDS"; }; then
    state_set last-summary "$(date +%s)"
    if [ "$code" = 0 ]; then
      check=$(state_get check-result)
      summary="🗄 Резервные копии JoyRest: копий $(backup_count), $(backup_summary | sed 's/ ✅$//'), проверка целостности ${check:-ещё не проводилась}"
      if [ -n "$(state_get restore-result)" ]; then summary+=", проверка восстановления $(state_get restore-result)"; fi
      notify "$summary"
    elif [ "$code" = 2 ]; then
      notify "⚠️ Резервные копии: $BACKUP_REASON"
    fi
  fi
}

# ------------------------------------------------------------------ команды

cmd_status() {
  echo "Основная: $(release_value prod APP_VERSION | cut -c1-12)   тестовая: $(release_value test APP_VERSION | cut -c1-12)"
  local env
  for env in prod test; do
    [ -f "$DEPLOY_DIR/status-$env" ] && echo "Выкладка $env: $(cat "$DEPLOY_DIR/status-$env")"
  done
  echo
  dc ps --format 'table {{.Service}}\t{{.Status}}'
  echo
  echo -n "Здоровье (основная): "; health prod || true
  echo -n "Здоровье (тестовая): "; health test || true
  echo "Сайт joy-rest.ru: $(site_enabled && echo включён || echo 'выключен (заглушка)'),"\
    "индексация $(env_value "$SETTINGS_FILE" SITE_INDEXING | grep . || echo off)," \
    "бот заявок $(grep -q '^LEAD_TELEGRAM_TOKEN=.' "$ROOT_DIR/secrets.env" 2>/dev/null && echo настроен || echo 'НЕ настроен (sudo joyrest lead-bot)')," \
    "пароль test.joy-rest.ru $([ -s "$SITE_AUTH_DIR/test-site-owner.caddy" ] && echo задан || echo 'НЕ задан (sudo joyrest site-password)')"
  echo "Данные games.joy-rest.ru: $(data_backend) (sudo joyrest data server|firebase)"
  echo "Резервная копия: $(backup_summary)," \
    "служебный бот $(grep -q '^NOTIFY_TELEGRAM_TOKEN=.' "$ROOT_DIR/secrets.env" 2>/dev/null && echo настроен || echo 'НЕ настроен (sudo joyrest notify-bot)')"
  echo
  df -h / | awk 'NR==2{print "Диск: занято " $5 " (" $3 " из " $2 ")"}'
  free -m | awk '/^Mem:/{print "Память: занято " $3 " МБ из " $2 " МБ"} /^Swap:/{print "Подкачка: " $3 " МБ из " $2 " МБ"}'
  [ -f /var/run/reboot-required ] && echo "⚠️  Нужна перезагрузка (обновилось ядро) — RUNBOOK, «Обновления системы»"
  echo
  docker stats --no-stream --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}'
}

cmd_logs() {
  local service="${1:-}" lines="${2:-100}"
  if [[ "$service" =~ ^[0-9]+$ ]]; then lines="$service"; service=""; fi
  case "$service" in ""|app-prod|app-test|caddy|postgres) ;; *) die "Нет сервиса $service" ;; esac
  [[ "$lines" =~ ^[0-9]+$ ]] || die "N — число строк"
  if [ -n "$service" ]; then
    dc logs --no-color --timestamps --tail "$lines" "$service"
  else
    dc logs --no-color --timestamps --tail "$lines"
  fi
}

cmd_restart() {
  need_root restart
  case "${1:-}" in
    "") dc restart ;;
    app-prod|app-test|caddy|postgres) dc restart "$1" ;;
    *) die "Нет сервиса $1" ;;
  esac
}

cmd_up() {
  need_root up
  ensure_dirs
  write_runtime
  # Свежие копии caddy и postgres из GHCR (обновляются раз в неделю); без связи — работаем на старых.
  dc pull -q caddy postgres >/dev/null 2>&1 || log "Не удалось обновить образы caddy/postgres — оставляю текущие"
  dc up -d postgres
  wait_postgres || die "PostgreSQL не запустилась за 90 секунд."
  ensure_test_db || die "Не удалось создать базу joyrest_test."
  if install_system; then dc up -d --remove-orphans; reload_caddy; else dc up -d --remove-orphans; fi
}

cmd_deploy() {
  need_root deploy
  deploy_env prod "${1:-}" "${2:-}"
}

cmd_deploy_test() {
  need_root deploy-test
  [ $# -le 1 ] || die "Тестовой выкладке force не нужен."
  deploy_env test "${1:-}"
}

cmd_rollback() {
  need_root rollback
  local env=prod current prev
  [ "${1:-}" = test ] && env="test"
  current=$(release_value "$env" APP_VERSION)
  prev=$(grep -vx "$current" "$DEPLOY_DIR/history-$env" 2>/dev/null | tail -n 1 || true)
  [[ "$prev" =~ $SHA_RE ]] || die "Нет прошлой версии для отката."
  log "[$env] откат вручную: $current → $prev"
  deploy_env "$env" "$prev" force
}

# Выложить по тегу GHCR: коммит берётся из образа (APP_VERSION).
cmd_activate() {
  need_root activate
  local tag="${1:?Укажите тег, например: sudo joyrest activate main}" sha
  [[ "$tag" =~ ^[A-Za-z0-9._-]+$ ]] || die "Неверный тег: $tag"
  docker pull -q "$APP_REPO:$tag" >/dev/null || die "Не скачался образ $APP_REPO:$tag."
  sha=$(docker image inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$APP_REPO:$tag" | sed -n 's/^APP_VERSION=//p')
  [[ "$sha" =~ $SHA_RE ]] || die "В образе $tag нет версии-коммита."
  docker tag "$APP_REPO:$tag" "$APP_REPO:sha-$sha"
  deploy_env prod "$sha" force
}

# Очередь от привратника SSH: файлы queue/prod и queue/test с «<коммит> [force]».
cmd_process_queue() {
  need_root process-queue
  local env file request sha force code entry
  # Недописанные временные файлы привратника (.request.*) старше часа — мусор.
  find "$QUEUE_DIR" -maxdepth 1 -name '.request.*' -mmin +60 -delete 2>/dev/null || true
  # В очереди бывают только обычные файлы prod и test. Всё остальное (каталог, ссылка,
  # другое имя) удаляем, иначе служба запускалась бы по кругу.
  for entry in "$QUEUE_DIR"/[a-z]*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    case "$(basename "$entry")" in
      prod|test) [ -f "$entry" ] && [ ! -L "$entry" ] && continue ;;
    esac
    rm -rf -- "$entry"
    log "Очередь: удалён лишний объект $(basename "$entry" | tr -cd 'a-z0-9._-' | cut -c1-40)"
  done
  for env in prod test; do
    file="$QUEUE_DIR/$env"
    [ -f "$file" ] || continue
    request=$(head -c 100 "$file")
    rm -f "$file"
    # Привратнику не доверяем: формат проверяется заново.
    if [[ "$request" =~ ^([0-9a-f]{40})(\ force)?$ ]]; then
      sha=${BASH_REMATCH[1]}
      force=${BASH_REMATCH[2]# }
      [ "$env" = test ] && force=""
      # Подоболочка: die внутри выкладки не обрывает обработку второго окружения.
      code=0; ( deploy_env "$env" "$sha" "$force" ) || code=$?
      log "[$env] очередь: $sha завершена с кодом $code"
    else
      log "[$env] очередь: отклонён запрос неверного формата"
    fi
  done
}

# Отпечаток образа по тегу в GHCR (только чтение, токен read:packages из входа docker).
registry_digest() {
  local tag=$1 repo_path=${APP_REPO#*/} auth="" token headers
  if [[ "$REGISTRY" == https://* ]]; then
    local cred
    cred=$(jq -r --arg host "${REGISTRY#https://}" '.auths[$host].auth // empty' /root/.docker/config.json 2>/dev/null | base64 -d 2>/dev/null || true)
    [ -n "$cred" ] || return 1
    token=$(curl -fsS --max-time 15 -u "$cred" \
      "$REGISTRY/token?service=${REGISTRY#https://}&scope=repository:$repo_path:pull" | jq -r '.token // empty') || return 1
    [ -n "$token" ] || return 1
    auth="Authorization: Bearer $token"
  fi
  headers=$(curl -fsSI --max-time 15 ${auth:+-H "$auth"} \
    -H 'Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json' \
    "$REGISTRY/v2/$repo_path/manifests/$tag") || return 1
  echo "$headers" | tr -d '\r' | sed -n 's/^[Dd]ocker-[Cc]ontent-[Dd]igest: *//p'
}

# Запасной путь: каждые 2 минуты (таймер systemd) сверяем тег test-release — только тестовая версия.
# Основная по тегу не выкладывается (аудит 7 октября 2026): тег в GHCR может поставить сборка любой
# ветки, а основной релиз ставит команды и службы от root. Основная — по SSH из main (окружение
# GitHub production) или вручную: sudo joyrest deploy <коммит>.
cmd_auto_update() {
  need_root auto-update
  local env tag remote deployed sha
  for env in test; do
    tag=test-release
    remote=$(registry_digest "$tag" 2>/dev/null) || continue
    [[ "$remote" =~ ^sha256:[0-9a-f]{64}$ ]] || continue
    deployed=$(release_value "$env" APP_IMAGE)
    [ "${deployed##*@}" = "$remote" ] && continue
    [ "$env" = test ] && [ ! -e "$ROOT_DIR/test-current" ] && [ "$(release_value prod APP_IMAGE)" = "$APP_REPO@$remote" ] && continue
    docker pull -q "$APP_REPO@$remote" >/dev/null 2>&1 || continue
    sha=$(docker image inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$APP_REPO@$remote" | sed -n 's/^APP_VERSION=//p')
    [[ "$sha" =~ $SHA_RE ]] || continue
    [ "$(release_value "$env" APP_VERSION)" = "$sha" ] && continue
    # Сломанный релиз не пытаемся выложить каждые 2 минуты.
    [ "$(cat "$DEPLOY_DIR/failed-$env" 2>/dev/null)" = "$sha" ] && continue
    docker tag "$APP_REPO@$remote" "$APP_REPO:sha-$sha"
    log "[$env] сервер сам забирает релиз $sha (тег $tag)"
    ( deploy_env "$env" "$sha" ) || true
  done
}

# Ключи выкладки из GitHub Actions. prod — основной (секрет DEPLOY_SSH_KEY только в окружении
# GitHub production, пускает только main); test — ключ веток claude/* (секрет репозитория
# DEPLOY_SSH_KEY_TEST), привратник пускает его только на ping, status и deploy-test.
# Повторный запуск заменяет прежний ключ того же вида. Закрытый ключ показывается один раз
# (hex одной строкой, как ждёт сборка) и на сервере не остаётся.
cmd_deploy_key() {
  need_root deploy-key
  local kind=${1:-} keys=/home/deploy/.ssh/authorized_keys tmp hex comment gate secret where
  case "$kind" in
    prod) comment=github-actions-deploy; gate=/usr/local/bin/joyrest-gate; secret=DEPLOY_SSH_KEY
      where="окружение production → Environment secrets" ;;
    test) comment=github-actions-test; gate="/usr/local/bin/joyrest-gate test"; secret=DEPLOY_SSH_KEY_TEST
      where="Secrets and variables → Actions → Secrets (секрет репозитория)" ;;
    *) die "Какой ключ: sudo joyrest deploy-key test (ветки) или sudo joyrest deploy-key prod (main)." ;;
  esac
  [ -t 0 ] || die "Запустите в Termius: sudo joyrest deploy-key $kind"
  install -d -m 700 -o deploy -g deploy /home/deploy/.ssh
  tmp=$(umask 077 && mktemp -d) || die "Не удалось создать временную папку."
  ssh-keygen -q -t ed25519 -N "" -C "$comment" -f "$tmp/key" || { rm -rf "$tmp"; die "Не удалось создать ключ."; }
  {
    if [ -f "$keys" ]; then grep -v " $comment\$" "$keys" || true; fi
    echo "restrict,command=\"$gate\" $(cat "$tmp/key.pub")"
  } > "$keys.new"
  chown deploy:deploy "$keys.new" && chmod 600 "$keys.new" && mv -f "$keys.new" "$keys"
  hex=$(xxd -p "$tmp/key" | tr -d '\n')
  shred -u "$tmp/key" "$tmp/key.pub" 2>/dev/null || rm -f "$tmp/key" "$tmp/key.pub"
  rmdir "$tmp"
  log "[deploy-key] новый ключ выкладки ($kind)"
  echo "Скопируйте строку ниже целиком в секрет $secret"
  echo "(GitHub → Settings → $where). Больше она не покажется; прежний ключ $kind уже не работает."
  echo
  echo "$hex"
  echo
  hex=""
}

# Бот для заявок с сайта: токен вводится скрыто и хранится только в secrets.env.
cmd_lead_bot() {
  need_root lead-bot
  local force=${1:-} token chat answer
  [ -z "$force" ] || [ "$force" = force ] || die "Аргумент — только force."
  [ -t 0 ] || die "Команда спрашивает токен: запустите её в Termius — sudo joyrest lead-bot"
  ensure_no_game "$force" lead-bot

  echo "Токен бота: @BotFather → /mybots → ваш бот → API Token. При вводе символы не видны — это нормально."
  read -rsp "Токен бота: " token
  echo
  token=$(clean_value "$token")
  [[ "$token" =~ ^[0-9]{6,12}:[A-Za-z0-9_-]{30,}$ ]] || die "Не похоже на токен (нужен вид 123456789:AA…). Ничего не изменено."

  echo
  echo "Чат для заявок: id группы (например -1001234567890) или ваш личный id."
  echo "Бота нужно добавить в группу (или написать ему /start в личке), иначе он не сможет писать."
  read -rp "Chat id: " chat
  chat=$(clean_value "$chat")
  [[ "$chat" =~ ^-?[0-9]{5,20}$ ]] || die "Chat id — число (у групп начинается с минуса). Ничего не изменено."

  echo "Проверяю бота и отправляю пробное сообщение…"
  if telegram_call "$token" getMe '{}' \
    && telegram_call "$token" sendMessage "{\"chat_id\":\"$chat\",\"text\":\"✅ JoyRest: заявки с сайта joy-rest.ru будут приходить сюда.\"}"; then
    echo "✅ Пробное сообщение отправлено — проверьте чат."
  else
    echo "⚠️  Проверка не прошла (причина выше)."
    read -rp "Сохранить всё равно? Напишите да или нет: " answer
    [ "$(clean_value "$answer")" = да ] || die "Ничего не изменено."
  fi

  set_env_value "$ROOT_DIR/secrets.env" LEAD_TELEGRAM_TOKEN "$token" || die "Не удалось записать secrets.env."
  set_env_value "$ROOT_DIR/secrets.env" LEAD_TELEGRAM_CHAT_ID "$chat" || die "Не удалось записать secrets.env."
  token=""
  log "Бот заявок сайта: токен и чат обновлены (secrets.env)"
  echo "Перезапускаю приложение…"
  recreate_apps app-prod app-test
  echo "✅ Готово. Отправьте пробную заявку с https://joy-rest.ru (или test.joy-rest.ru)."
}

site_enabled() {
  [ "$(env_value "$SETTINGS_FILE" SITE_ENABLED)" = on ]
}

# Сайт на joy-rest.ru: off (по умолчанию) — заглушка «скоро», заявки не принимаются (404).
cmd_site() {
  local value=${1:-} force=${2:-} current
  current=$(env_value "$SETTINGS_FILE" SITE_ENABLED)
  if [ -z "$value" ]; then
    echo "Сайт joy-rest.ru: ${current:-off} (on — сайт и заявки, off — заглушка «скоро»)"
    echo "Индексация: $(env_value "$SETTINGS_FILE" SITE_INDEXING | grep . || echo off)"
    return 0
  fi
  need_root site
  case "$value" in on|off) ;; *) die "Значение — on или off: sudo joyrest site on" ;; esac
  [ -z "$force" ] || [ "$force" = force ] || die "Второй аргумент — только force."
  ensure_no_game "$force" "site $value"
  set_env_value "$SETTINGS_FILE" SITE_ENABLED "$value" || die "Не удалось записать $SETTINGS_FILE."
  # Выключенный сайт поисковикам не открыт: при следующем включении индексацию — заново.
  if [ "$value" = off ]; then
    set_env_value "$SETTINGS_FILE" SITE_INDEXING off || die "Не удалось записать $SETTINGS_FILE."
  fi
  log "Сайт joy-rest.ru: ${current:-off} → $value"
  recreate_apps app-prod
  if [ "$value" = on ]; then
    echo "✅ Сайт включён на https://joy-rest.ru, заявки принимаются."
    grep -q '^LEAD_TELEGRAM_TOKEN=.' "$ROOT_DIR/secrets.env" 2>/dev/null \
      || echo "⚠️  Бот заявок не настроен — формы отвечают «временно не работает»: sudo joyrest lead-bot"
    echo "Поисковикам сайт закрыт; открыть — sudo joyrest site-indexing on"
  else
    echo "✅ Сайт выключен: на https://joy-rest.ru заглушка «скоро», заявки не принимаются."
  fi
}

# Логин и пароль для test.joy-rest.ru. Пароль вводится скрыто, хэшируется в контейнере caddy
# (через stdin, не аргументом), на сервере остаётся только bcrypt-хэш.
cmd_site_password() {
  need_root site-password
  local user password again hash file tmp
  [ -t 0 ] || die "Команда спрашивает пароль: запустите её в Termius — sudo joyrest site-password"
  read -rp "Логин (латиница, цифры, точка, дефис; Enter — joyrest): " user
  user=$(clean_value "$user")
  user=${user:-joyrest}
  [[ "$user" =~ ^[A-Za-z0-9._-]{3,32}$ ]] || die "Логин: 3–32 символа, латиница, цифры, точка, дефис, подчёркивание."
  [ "$user" != joyrest-locked ] || die "Этот логин занят служебной записью — выберите другой."
  echo "Пароль не короче 12 символов. При вводе символы не видны — это нормально."
  IFS= read -rsp "Пароль: " password
  echo
  IFS= read -rsp "Пароль ещё раз: " again
  echo
  [ "$password" = "$again" ] || die "Пароли не совпали. Ничего не изменено."
  # Длина в символах, а не в байтах (под sudo локаль бывает C, а кириллица — 2 байта).
  [ "$(printf '%s' "$password" | LC_ALL=C.UTF-8 wc -m)" -ge 12 ] || die "Пароль короче 12 символов. Ничего не изменено."
  hash=$(printf '%s\n' "$password" | dc exec -T caddy caddy hash-password --bcrypt-cost 10 2>/dev/null) || hash=""
  password=""
  again=""
  [[ "$hash" =~ ^\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$ ]] || die "Caddy не посчитал хэш (контейнер caddy запущен? joyrest status). Ничего не изменено."

  ensure_dirs
  file="$SITE_AUTH_DIR/test-site-owner.caddy"
  tmp=$(umask 077 && mktemp "$file.XXXXXX") || die "Не удалось записать $file."
  if ! { printf '%s %s\n' "$user" "$hash" > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$file"; }; then
    rm -f "$tmp"
    die "Не удалось записать $file."
  fi
  log "Пароль test.joy-rest.ru обновлён (логин $user)"
  reload_caddy
  echo "✅ Готово: https://test.joy-rest.ru — логин $user и ваш пароль."
}

# Индексация сайта поисковиками: off (по умолчанию) — robots.txt Disallow и X-Robots-Tag noindex.
cmd_site_indexing() {
  local value=${1:-} force=${2:-} current
  current=$(env_value "$SETTINGS_FILE" SITE_INDEXING)
  if [ -z "$value" ]; then
    echo "Индексация joy-rest.ru: ${current:-off} (on — открыт поисковикам, off — закрыт)"
    site_enabled || echo "Сайт выключен (sudo joyrest site) — поисковикам закрыт в любом случае."
    return 0
  fi
  need_root site-indexing
  case "$value" in on|off) ;; *) die "Значение — on или off: sudo joyrest site-indexing on" ;; esac
  [ -z "$force" ] || [ "$force" = force ] || die "Второй аргумент — только force."
  if [ "$value" = on ] && ! site_enabled; then
    die "Сайт выключен — открыть поисковикам можно только включённый сайт: сначала sudo joyrest site on"
  fi
  ensure_no_game "$force" "site-indexing $value"
  set_env_value "$SETTINGS_FILE" SITE_INDEXING "$value" || die "Не удалось записать $SETTINGS_FILE."
  log "Индексация сайта: ${current:-off} → $value"
  recreate_apps app-prod
  if [ "$value" = on ]; then
    echo "✅ Сайт открыт поисковикам. Проверка: https://joy-rest.ru/robots.txt — должно быть «Allow: /»."
  else
    echo "✅ Сайт закрыт от поисковиков. Проверка: https://joy-rest.ru/robots.txt — должно быть «Disallow: /»."
  fi
}

# Служебный бот сервера (тот же, что пишет «✅ Выложено» из GitHub Actions): токен вводится
# скрыто и хранится только в secrets.env. Приложения его не используют — перезапуск не нужен.
cmd_notify_bot() {
  need_root notify-bot
  local token chat answer
  [ -t 0 ] || die "Команда спрашивает токен: запустите её в Termius — sudo joyrest notify-bot"

  echo "Токен служебного бота (JoyRest_Сервер): @BotFather → /mybots → бот → API Token."
  echo "При вводе символы не видны — это нормально."
  read -rsp "Токен бота: " token
  echo
  token=$(clean_value "$token")
  [[ "$token" =~ ^[0-9]{6,12}:[A-Za-z0-9_-]{30,}$ ]] || die "Не похоже на токен (нужен вид 123456789:AA…). Ничего не изменено."

  echo
  echo "Чат для сообщений сервера — тот же, куда приходит «✅ Выложено» (TELEGRAM_CHAT_ID в GitHub):"
  echo "id группы (например -1001234567890) или ваш личный id."
  read -rp "Chat id: " chat
  chat=$(clean_value "$chat")
  [[ "$chat" =~ ^-?[0-9]{5,20}$ ]] || die "Chat id — число (у групп начинается с минуса). Ничего не изменено."

  echo "Проверяю бота и отправляю пробное сообщение…"
  if telegram_call "$token" getMe '{}' \
    && telegram_call "$token" sendMessage "{\"chat_id\":\"$chat\",\"text\":\"✅ JoyRest: сообщения сервера (резервные копии) будут приходить сюда.\"}"; then
    echo "✅ Пробное сообщение отправлено — проверьте чат."
  else
    echo "⚠️  Проверка не прошла (причина выше)."
    read -rp "Сохранить всё равно? Напишите да или нет: " answer
    [ "$(clean_value "$answer")" = да ] || die "Ничего не изменено."
  fi

  set_env_value "$ROOT_DIR/secrets.env" NOTIFY_TELEGRAM_TOKEN "$token" || die "Не удалось записать secrets.env."
  set_env_value "$ROOT_DIR/secrets.env" NOTIFY_TELEGRAM_CHAT_ID "$chat" || die "Не удалось записать secrets.env."
  token=""
  log "Служебный бот: токен и чат обновлены (secrets.env)"
  echo "✅ Готово. Сюда придёт сообщение, если резервная копия не получится, и итог раз в неделю."
}

# Пароль restic: 32 символа без похожих (0/O, 1/l/I) — удобно копировать и, если что, ввести руками.
new_backup_password() {
  local raw
  raw=$(head -c 1024 /dev/urandom | LC_ALL=C tr -dc 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789')
  [ "${#raw}" -ge 32 ] || return 1
  printf '%s' "${raw:0:32}"
}

# Хранилище restic: подключение к Beget S3, пароль копий, первая копия.
cmd_backup_setup() {
  need_root backup-setup
  local endpoint bucket key secret password tmp out answer tries=0
  [ -t 0 ] || die "Команда спрашивает ключи: запустите её в Termius — sudo joyrest backup-setup"
  if ! command -v restic >/dev/null 2>&1; then
    echo "Устанавливаю restic…"
    apt-get -y -q install restic >/dev/null || die "Не удалось установить restic (apt-get install restic)."
  fi
  ensure_dirs
  if backup_configured; then
    read -rp "Резервные копии уже настроены. Настроить заново? Напишите да или нет: " answer
    [ "$(clean_value "$answer")" = да ] || die "Ничего не изменено."
  fi

  echo "Данные бакета — в панели Beget: Облако → S3-хранилище → ваш бакет (RUNBOOK, «Резервные копии»)."
  read -rp "Адрес хранилища (Enter — https://s3.ru1.storage.beget.cloud): " endpoint
  endpoint=$(clean_value "$endpoint")
  endpoint=${endpoint:-https://s3.ru1.storage.beget.cloud}
  endpoint=${endpoint%/}
  [[ "$endpoint" =~ ^https://[a-z0-9.-]+(:[0-9]+)?$ ]] || die "Адрес — вида https://s3.ru1.storage.beget.cloud. Ничего не изменено."
  read -rp "Имя бакета: " bucket
  bucket=$(clean_value "$bucket")
  [[ "$bucket" =~ ^[a-z0-9][a-z0-9.-]{1,62}$ ]] || die "Имя бакета — строчные латинские буквы, цифры, точка, дефис. Ничего не изменено."
  read -rp "Access key: " key
  key=$(clean_value "$key")
  [[ "$key" =~ ^[A-Za-z0-9]{8,128}$ ]] || die "Access key — латинские буквы и цифры. Ничего не изменено."
  echo "Secret key (символы не видны — это нормально)."
  read -rsp "Secret key: " secret
  echo
  secret=$(clean_value "$secret")
  [[ "$secret" =~ ^[A-Za-z0-9/+=]{16,128}$ ]] || die "Не похоже на secret key. Ничего не изменено."

  tmp=$(umask 077 && mktemp "$ROOT_DIR/.backup-env.XXXXXX") || die "Не удалось создать временный файл."
  # shellcheck disable=SC2064
  trap "rm -f '$tmp'" EXIT
  printf 'RESTIC_REPOSITORY=s3:%s/%s/joyrest\nAWS_ACCESS_KEY_ID=%s\nAWS_SECRET_ACCESS_KEY=%s\nRESTIC_PASSWORD=probe\n' \
    "$endpoint" "$bucket" "$key" "$secret" > "$tmp"

  echo "Проверяю доступ к бакету…"
  out=$(BACKUP_ENV=$tmp restic_run cat config 2>&1) || true
  if [[ "$out" == *"wrong password"* ]]; then
    # Копии уже есть (сервер переустановлен) — нужен сохранённый пароль.
    echo "В бакете уже есть резервные копии JoyRest. Введите сохранённый пароль копий (символы не видны)."
    read -rsp "Пароль копий: " password
    echo
    password=$(clean_value "$password")
    set_env_value "$tmp" RESTIC_PASSWORD "$password" || die "Не удалось записать временный файл."
    out=$(BACKUP_ENV=$tmp restic_run cat config 2>&1 >/dev/null) || die "Пароль не подошёл: $(short_reason "$out"). Ничего не изменено."
    echo "✅ Пароль подошёл, копии доступны."
  elif [[ "$out" == *"bucket does not exist"* ]]; then
    die "Бакет $bucket не найден — проверьте имя в панели Beget. Ничего не изменено."
  elif [[ "$out" == *"does not exist"* || "$out" == *"no such file or directory"* ]]; then
    # Хранилища ещё нет (S3: «The specified key does not exist», локально — «no such file») —
    # создаём с новым паролем.
    password=$(new_backup_password) || die "Не удалось создать пароль."
    echo
    echo "Пароль резервных копий. Без него копии не расшифровать никому — ни вам, ни нам."
    echo "Скопируйте строку ниже целиком (долгое нажатие → Copy) и сохраните в менеджер паролей"
    echo "вместе с адресом хранилища, именем бакета и ключами S3."
    echo
    echo "$password"
    echo
    while :; do
      read -rp "Сохранили? Введите последние 4 символа пароля: " answer
      [ "$(clean_value "$answer")" = "${password: -4}" ] && break
      tries=$((tries + 1))
      [ "$tries" -lt 3 ] || die "Последние символы не совпали. Ничего не изменено — запустите команду заново, будет новый пароль."
      echo "Не совпало. Проверьте, что пароль сохранён целиком, и попробуйте ещё раз."
    done
    set_env_value "$tmp" RESTIC_PASSWORD "$password" || die "Не удалось записать временный файл."
    out=$(BACKUP_ENV=$tmp restic_run init 2>&1) || die "Хранилище не создалось: $(short_reason "$out"). Ничего не изменено."
    # Убираем пароль с экрана и из прокрутки Termius.
    printf '\033[3J\033[H\033[2J'
    echo "✅ Хранилище создано, пароль убран с экрана."
  else
    die "Нет доступа к хранилищу: $(short_reason "$out"). Проверьте адрес и ключи. Ничего не изменено."
  fi
  password=""
  secret=""

  chmod 600 "$tmp" && mv -f "$tmp" "$BACKUP_ENV" || die "Не удалось записать $BACKUP_ENV."
  trap - EXIT
  log "[backup] хранилище restic настроено ($endpoint, бакет $bucket)"
  echo "Делаю первую копию…"
  cmd_backup
  grep -q '^NOTIFY_TELEGRAM_TOKEN=.' "$ROOT_DIR/secrets.env" 2>/dev/null \
    || echo "Чтобы узнавать о неудачных копиях — служебный бот: sudo joyrest notify-bot"
}

# Копия сейчас (вручную).
cmd_backup() {
  need_root backup
  local code=0
  ensure_dirs
  exec 8>"$BACKUP_DIR/lock"
  flock -w 600 8 || die "Другая копия идёт дольше 10 минут."
  backup_once || code=$?
  case "$code" in
    0) state_set status "ok $(date '+%F %T')"; echo "✅ Копия сделана ($(state_get last-ok | cut -d' ' -f2))." ;;
    2) state_set status "local $(date '+%F %T')"; echo "⚠️  $BACKUP_REASON" ;;
    *) state_set status "failed $(date '+%F %T'): $BACKUP_REASON"; die "Копия не сделана: $BACKUP_REASON" ;;
  esac
}

cmd_backups() {
  need_root backups
  echo "Резервные копии базы в S3 (сроки: $KEEP_DAILY ежедневных, $KEEP_WEEKLY еженедельных, $KEEP_MONTHLY ежемесячных):"
  if backup_configured; then
    restic_run snapshots --host "$BACKUP_HOST" --tag db --compact || echo "⚠️  Нет доступа к хранилищу."
    echo "Проверка целостности: $(state_get check-result | grep . || echo 'ещё не было')"
    echo "Проверка восстановления: $(state_get restore-result | grep . || echo 'ещё не было')"
  else
    echo "  не настроено — sudo joyrest backup-setup"
  fi
  echo
  echo "На диске сервера:"
  find "$BACKUP_DIR/daily" "$BACKUP_DIR/predeploy" -name '*.dump' -printf '  %TF %TH:%TM  %s байт  %P (%h)\n' 2>/dev/null \
    | sed "s|$BACKUP_DIR/||" | sort -r
}

# restore <копия|latest> test — в тестовую базу; restore <копия|latest> prod [force] — в основную.
cmd_restore() {
  need_root restore
  local snap=${1:-} target=${2:-} force=${3:-} file out answer image version db
  [[ "$snap" =~ ^(latest|[0-9a-f]{8,64})$ ]] \
    || die "Укажите копию: sudo joyrest restore latest test (список копий — sudo joyrest backups)"
  case "$target" in
    test) [ -z "$force" ] || die "Тестовой базе force не нужен." ;;
    prod) [ -z "$force" ] || [ "$force" = force ] || die "Третий аргумент — только force." ;;
    *) die "Куда восстановить: test (тестовая база) или prod (основная)." ;;
  esac
  backup_configured || die "Хранилище не настроено: sudo joyrest backup-setup"
  if [ "$target" = prod ]; then
    [ -t 0 ] || die "Восстановление основной базы — только из Termius."
    ensure_no_game "$force" "restore $snap prod"
  fi

  ensure_dirs
  exec 8>"$BACKUP_DIR/lock"
  flock -w 600 8 || die "Идёт резервная копия дольше 10 минут — повторите позже."
  exec 9>"$DEPLOY_DIR/lock"
  flock -w 900 9 || die "Идёт выкладка дольше 15 минут — повторите позже."

  file=$(umask 077 && mktemp "$BACKUP_DIR/restore.XXXXXX") || die "Не удалось создать временный файл."
  # shellcheck disable=SC2064
  trap "rm -f '$file'" EXIT
  echo "Скачиваю копию $snap…"
  out=$(restic_run dump --host "$BACKUP_HOST" --tag db "$snap" /joyrest_prod.dump 2>&1 > "$file") \
    || die "Копия не скачалась: $(short_reason "$out")"
  dc exec -T postgres pg_restore --list < "$file" > /dev/null || die "Файл копии повреждён."

  if [ "$target" = prod ]; then
    restic_run snapshots --host "$BACKUP_HOST" --tag db --compact "$snap" 2>/dev/null | sed -n '3p' || true
    echo "Основная база будет заменена копией $snap. Приложение остановится примерно на минуту."
    echo "Текущая база сохранится как joyrest_prod_before_restore (до следующего восстановления)."
    read -rp "Чтобы продолжить, напишите: восстановить " answer
    [ "$(clean_value "$answer")" = восстановить ] || die "Ничего не изменено."
    if dump_prod "$BACKUP_DIR/predeploy/$(date '+%Y%m%d-%H%M%S')-before-restore.dump"; then
      log "[restore] дамп текущей базы сохранён в backups/predeploy"
    else
      echo "⚠️  Дамп текущей базы не получился — она всё равно сохранится как joyrest_prod_before_restore."
    fi
  fi

  echo "Восстанавливаю во временную базу…"
  out=$(restore_into joyrest_restore_tmp "$file" 2>&1) || die "Копия не восстановилась: $(short_reason "$out")"
  db=$([ "$target" = prod ] && echo joyrest_prod || echo joyrest_test)
  image=$(release_value "$target" APP_IMAGE)
  version=$(release_value "$target" APP_VERSION)

  dc stop "$(service_of "$target")" >/dev/null
  if [ "$target" = prod ]; then
    psql_in postgres "drop database if exists joyrest_prod_before_restore with (force)" >/dev/null 2>&1
    psql_in postgres "alter database joyrest_prod rename to joyrest_prod_before_restore" >/dev/null \
      || { dc up -d --no-deps app-prod; die "Не удалось отложить текущую базу. Ничего не изменено."; }
  else
    psql_in postgres "drop database if exists joyrest_test with (force)" >/dev/null 2>&1
  fi
  psql_in postgres "alter database joyrest_restore_tmp rename to $db" >/dev/null || die "Не удалось подставить базу."
  db_role_grants || echo "⚠️  Права ролей приложений не выданы — запустите: sudo joyrest db-roles"
  log "[restore] $db восстановлена из копии $snap"

  # Копия может быть старше схемы текущего кода: догоняем миграциями.
  if ! run_migrations "$target" "$image"; then
    if [ "$target" = prod ]; then
      psql_in postgres "alter database joyrest_prod rename to joyrest_restore_failed" >/dev/null
      psql_in postgres "alter database joyrest_prod_before_restore rename to joyrest_prod" >/dev/null
      dc up -d --no-deps app-prod
      die "Миграции на восстановленной базе не прошли — вернул прежнюю базу (копия — joyrest_restore_failed)."
    fi
    die "Миграции на восстановленной тестовой базе не прошли: joyrest logs app-test"
  fi
  dc up -d --no-deps "$(service_of "$target")" >/dev/null
  wait_healthy "$target" "$version" || die "$(service_of "$target") не ответил после восстановления: joyrest logs $(service_of "$target") 100"
  echo "✅ База $db восстановлена из копии $snap, приложение работает."
  echo "Картинки и музыку той же ночи: sudo joyrest restore-media <копия с тегом media> $target"
}

# Картинки, музыка и аватарки из копии (тег media). Файлы только добавляются: имена — sha256,
# существующие не перезаписываются, поэтому это безопасно и во время игры. Лишние уберёт ночная уборка.
cmd_restore_media() {
  need_root restore-media
  local snap=${1:-} target=${2:-} tmp out src dst file added=0
  [[ "$snap" =~ ^(latest|[0-9a-f]{8,64})$ ]] \
    || die "Укажите копию: sudo joyrest restore-media latest prod (список копий — sudo joyrest backups)"
  case "$target" in
    test|prod) ;;
    *) die "Куда восстановить: test или prod." ;;
  esac
  backup_configured || die "Хранилище не настроено: sudo joyrest backup-setup"
  ensure_dirs
  tmp=$(umask 077 && mktemp -d "$BACKUP_DIR/media-restore.XXXXXX") || die "Не удалось создать временную папку."
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT
  echo "Скачиваю картинки и музыку из копии $snap…"
  out=$(restic_run restore "$snap" --host "$BACKUP_HOST" --tag media --target "$tmp" 2>&1) \
    || die "Копия не скачалась: $(short_reason "$out")"
  src="$tmp$ROOT_DIR/media/prod"
  [ -d "$src" ] || die "В копии $snap нет картинок и музыки."
  dst="$ROOT_DIR/media/$target"
  install -d -m 700 -o 1000 -g 1000 "$dst"
  while IFS= read -r -d '' file; do
    file=${file#./}
    [ -e "$dst/$file" ] && continue
    install -D -m 644 -o 1000 -g 1000 "$src/$file" "$dst/$file"
    added=$((added + 1))
  done < <(cd "$src" && find . -type f ! -name '*.tmp' -print0)
  log "[restore] картинки и музыка из копии $snap → media/$target: добавлено файлов $added"
  echo "✅ Картинки и музыка из копии $snap: добавлено файлов — $added (существующие не тронуты)."
}

# Настройки (settings.env, пароль test.joy-rest.ru) из последней копии — после переустановки сервера.
cmd_restore_settings() {
  need_root restore-settings
  local answer out
  backup_configured || die "Хранилище не настроено: sudo joyrest backup-setup"
  [ -t 0 ] || die "Запустите в Termius: sudo joyrest restore-settings"
  read -rp "Заменить settings.env и пароль test.joy-rest.ru последней копией? Напишите да или нет: " answer
  [ "$(clean_value "$answer")" = да ] || die "Ничего не изменено."
  out=$(restic_run restore latest --host "$BACKUP_HOST" --tag config --target / 2>&1) \
    || die "Не удалось восстановить: $(short_reason "$out")"
  log "[restore] настройки восстановлены из копии"
  echo "✅ Настройки восстановлены. Применить: sudo joyrest up"
}

# Пароль владельца агентства для входа на своём сервере (CLAUDE.md, «Платформа на своём
# сервере»). Пароль вводится скрыто и уходит в приложение через stdin (не аргументом):
# server/admin-password.js (PR 3.1) хэширует его argon2id, в базе — только хэш.
# test — для тестового окружения (своя база).
cmd_admin_password() {
  need_root admin-password
  local target=${1:-prod} service email password again default out
  case "$target" in prod|test) ;; *) die "Аргумент — test или ничего (основная версия)." ;; esac
  service=$(service_of "$target")
  [ -t 0 ] || die "Команда спрашивает пароль: запустите её в Termius — sudo joyrest admin-password${1:+ $1}"
  if ! dc exec -T "$service" test -f server/admin-password.js 2>/dev/null; then
    die "В этой версии приложения ($(release_value "$target" APP_VERSION | cut -c1-12)) ещё нет входа на своём сервере — команда заработает после выкладки PR 3.1."
  fi
  default=$(env_value "$ROOT_DIR/secrets.env" ADMIN_EMAIL)
  read -rp "Почта для входа${default:+ (Enter — $default)}: " email
  email=$(clean_value "$email")
  email=${email:-$default}
  [[ "$email" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]] || die "Не похоже на почту. Ничего не изменено."
  echo "Пароль не короче 12 символов. При вводе символы не видны — это нормально."
  IFS= read -rsp "Пароль: " password
  echo
  IFS= read -rsp "Пароль ещё раз: " again
  echo
  [ "$password" = "$again" ] || die "Пароли не совпали. Ничего не изменено."
  [ "$(printf '%s' "$password" | LC_ALL=C.UTF-8 wc -m)" -ge 12 ] || die "Пароль короче 12 символов. Ничего не изменено."
  # Почта — первая строка stdin, пароль — вторая. printf встроен в bash: пароль не попадает в
  # аргументы процессов (их видно в списке процессов).
  if ! out=$(printf '%s\n%s\n' "$email" "$password" | dc exec -T "$service" node server/admin-password.js 2>&1); then
    password=""
    again=""
    die "Пароль не сохранён: $(printf '%s' "$out" | tail -n 1)"
  fi
  password=""
  again=""
  log "Пароль владельца агентства обновлён ($target)"
  echo "✅ Готово: https://$(host_of "$target")/studio — почта $email и ваш пароль."
}

# Слой данных основной версии (этап 9, CLAUDE.md «Переключатель»): DATA_BACKEND в settings.env.
# server — свой сервер (только если в основной базе есть владелец с паролем), firebase — откат.
# Меняет только владелец этой командой; выкладка и CI DATA_BACKEND не трогают.
data_backend() {
  local value
  value=$(env_value "$SETTINGS_FILE" DATA_BACKEND)
  [ "$value" = server ] && echo server || echo firebase
}

cmd_data() {
  local value=${1:-} force=${2:-} current owners
  current=$(data_backend)
  if [ -z "$value" ]; then
    echo "Данные games.joy-rest.ru: $current (server — свой сервер, firebase — Firebase)"
    return 0
  fi
  need_root data
  case "$value" in server|firebase) ;; *) die "Значение — server или firebase: sudo joyrest data server" ;; esac
  [ -z "$force" ] || [ "$force" = force ] || die "Второй аргумент — только force."
  if [ "$value" = "$current" ]; then
    echo "Уже $value — ничего не меняю."
    return 0
  fi
  if [ "$value" = server ]; then
    owners=$(psql_prod "select count(*) from users where role = 'admin' and active and password_hash is not null" 2>/dev/null) \
      || die "Не удалось проверить основную базу. Ничего не изменено."
    [ "${owners:-0}" -gt 0 ] 2>/dev/null \
      || die "В основной базе нет владельца с паролем — сначала: sudo joyrest admin-password. Ничего не изменено."
  fi
  ensure_no_game "$force" "data $value"
  set_env_value "$SETTINGS_FILE" DATA_BACKEND "$value" || die "Не удалось записать $SETTINGS_FILE."
  log "Данные games.joy-rest.ru: $current → $value"
  recreate_apps app-prod
  if [ "$value" = server ]; then
    echo "✅ games.joy-rest.ru работает на своём сервере. Вход — почта и пароль из admin-password."
    echo "Вернуть Firebase: sudo joyrest data firebase"
  else
    echo "✅ games.joy-rest.ru снова на Firebase. Данные своего сервера сохранены в базе."
  fi
}

cmd_version() {
  echo "основная: $(release_value prod APP_VERSION)"
  echo "тестовая: $(release_value test APP_VERSION)"
}

case "${1:-}" in
  status)        cmd_status ;;
  logs)          shift; cmd_logs "$@" ;;
  restart)       shift; cmd_restart "$@" ;;
  up)            cmd_up ;;
  deploy)        shift; cmd_deploy "$@" ;;
  deploy-test)   shift; cmd_deploy_test "$@" ;;
  rollback)      shift; cmd_rollback "$@" ;;
  activate)      shift; cmd_activate "$@" ;;
  process-queue) cmd_process_queue ;;
  auto-update)   cmd_auto_update ;;
  version)       cmd_version ;;
  site)          shift; cmd_site "$@" ;;
  site-password) cmd_site_password ;;
  lead-bot)      shift; cmd_lead_bot "$@" ;;
  site-indexing) shift; cmd_site_indexing "$@" ;;
  backup)        cmd_backup ;;
  backup-setup)  cmd_backup_setup ;;
  backup-nightly) cmd_backup_nightly ;;
  backups)       cmd_backups ;;
  restore)       shift; cmd_restore "$@" ;;
  restore-settings) cmd_restore_settings ;;
  restore-media) shift; cmd_restore_media "$@" ;;
  notify-bot)    cmd_notify_bot ;;
  admin-password) shift; cmd_admin_password "$@" ;;
  db-roles)      shift; cmd_db_roles "$@" ;;
  deploy-key)    shift; cmd_deploy_key "$@" ;;
  data)          shift; cmd_data "$@" ;;
  *)             usage ;;
esac
