{
  "name": "joyrest-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-joyrest \"vitest run --config vitest.rules.config.ts\"",
    "simulate": "firebase emulators:exec --only firestore,auth --project demo-joyrest \"tsx scripts/simulate.ts\"",
    "build:server": "esbuild server/src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=build/server/main.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start:server": "node build/server/main.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "firebase": "^12.19.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.32.1",
    "jsqr": "^1.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
